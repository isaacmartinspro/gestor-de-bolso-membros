# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# NUNCA exponha essa chave no navegador — só é usada no servidor (webhook e checagens de assinatura)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Token secreto que você mesmo escolhe. Configure o mesmo valor no Voomp (se ele permitir
# enviar um header/parâmetro customizado) ou valide via IP/assinatura conforme a documentação do Voomp.
VOOMP_WEBHOOK_SECRET=escolha-um-segredo-forte-aqui

# URL pública do site em produção (usada nos links de e-mail de criar senha)
NEXT_PUBLIC_SITE_URL=https://membros.isaacmartins.com.br
